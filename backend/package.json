{
  "name": "@inkstack/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --minify",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@inkstack/common": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.6",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.148.0"
  }
}
