generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  bio          String?
  // "pbkdf2_sha256$<iterations>$<salt>$<hash>"; legacy rows may still hold
  // plain text and are re-hashed on the next successful sign-in.
  passwordHash String   @map("password")
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Post {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  content     String
  // Stored on write so list queries never have to load full post bodies.
  excerpt     String
  readingTime Int
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  tags        Tag[]

  @@index([authorId])
  @@index([published, publishedAt(sort: Desc), id])
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  posts Post[]
}
